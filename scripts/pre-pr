#!/usr/bin/env python3
"""Fast, path-aware checks to run before opening or pushing a pull request.

Usage:
    scripts/pre-pr               # check everything changed against origin/main
    scripts/pre-pr --plan        # list the checks that would run, then exit
    scripts/pre-pr --full        # whole affected test targets instead of matched tests
    scripts/pre-pr --base REF    # compare against another base
    scripts/pre-pr --fetch       # fetch origin/main first
    scripts/pre-pr --markdown    # print the PR-body summary after the run

It compares HEAD plus uncommitted and untracked files with the merge base of
--base, selects the lint, build and unit-test checks for each affected area,
and writes a machine-readable summary to .build/pre-pr/summary.json (and a
Markdown copy for the PR body). The exit status is 0 only when every selected
check passed. Advisory checks report "warn" and never fail the run.

It fails closed: a required check whose tool is missing fails, and so does a
Swift change that runs no unit tests (no covering test target, an empty filter
or a filter that matches nothing). Unit tests are chosen from the SwiftPM target
graph (`swift package dump-package`): every test file, in a test target that
depends on the changed module, that names a type the changed file declares or
extends. Unmatched changes fall back to the module's whole test target.

Safety: it never runs UI tests, xcodebuild, the core-journey harness, app
launches or other foreground automation. Swift tests use a private file
Keychain (JSTI_TEST_KEYCHAIN=1) in a separate scratch path, so the developer's
Keychain and normal .build stay untouched.
"""
from __future__ import annotations

import argparse
import contextlib
import datetime as dt
import fnmatch
import functools
import importlib.util
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
from dataclasses import dataclass, field
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
OUT = Path(os.environ.get('JSTI_PRE_PR_OUT') or ROOT / '.build' / 'pre-pr')
SCHEMA_VERSION = 1
IS_MAC = sys.platform == 'darwin'

# Test targets that drive real UI. They are never selected, whatever changed.
UI_TEST_TARGETS = {'SpeakAppUITests', 'SpeakiOSUITests'}

# Test targets the macOS job leaves to Portable Swift (Linux), as ci.yml passes them to affected-swift-tests.py.
CI_MACOS_SKIP_TARGETS = {'SpeakDesktopTests', 'SpeakAutomationKitTests'}
# Cheap static checks run first so most failures surface within seconds.
COST = {'swift-test-coverage': 0, 'actionlint': 0, 'shellcheck': 0, 'swiftformat': 1, 'landing-tests': 1,
        'ci-lint': 2, 'apple-build': 3, 'apple-unit-tests': 4, 'api-compatibility': 5}


def git(*args: str, check: bool = True) -> str:
    result = subprocess.run(['git', *args], cwd=ROOT, text=True, capture_output=True)
    if check and result.returncode != 0:
        raise SystemExit(f'pre-pr: git {" ".join(args)} failed: {result.stderr.strip()}')
    return result.stdout.strip()


def changed_files(base: str) -> tuple[str, list[str]]:
    merge_base = git('merge-base', 'HEAD', base)
    files = set(filter(None, git('diff', '--name-only', merge_base).splitlines()))
    files |= set(filter(None, git('ls-files', '--others', '--exclude-standard').splitlines()))
    return merge_base, sorted(files)


@dataclass
class Check:
    id: str
    area: str
    title: str
    command: list[str]
    cwd: Path = ROOT
    env: dict[str, str] = field(default_factory=dict)
    advisory: bool = False
    requires: str | None = None
    skip_reason: str = ''
    failure: str = ''          # a planning failure: the check fails without running
    counts_tests: bool = False  # fail when the run executes zero tests
    background: bool = False    # started first and awaited last (the remote/container Linux run)
    forbid_drift: tuple[str, ...] = ()  # tracked files the check must not modify (CI's drift checks)
    incomplete: bool = False    # a required check deliberately not run: the result is 'incomplete'
    status: str = 'pending'
    duration: float = 0.0
    note: str = ''
    started: float = 0.0
    dirty_before: set = field(default_factory=set)

    @property
    def log(self) -> Path:
        return OUT / 'logs' / f'{self.id}.log'


# Top-level declarations a test can reference. Private and fileprivate types are invisible to tests.
DECL = re.compile(r'^(?:@[\w.]+(?:\([^)\n]*\))?\s+)*(?:(?:public|package|internal|open|final|indirect|nonisolated)\s+)*'
                  r'(class|struct|enum|protocol|actor|typealias|extension)\s+([A-Za-z_]\w*)', re.M)
TEST_TYPE = re.compile(r'^(?:@[\w.]+(?:\([^)\n]*\))?\s+)*(?:(?:public|internal|private|fileprivate|final)\s+)*'
                       r'(?:class|struct|actor|enum|extension)\s+([A-Za-z_]\w*)', re.M)
# Opt-in test files are wrapped in `#if JSTI_<NAME>_INTEGRATION` and only compile on request.
OPT_IN = re.compile(r'^#if JSTI_\w+_INTEGRATION\b', re.M)
# Imports and line comments name modules and prose, not the types a test exercises.
NOT_CODE = re.compile(r'^\s*(?:@testable\s+)?import\s+.*$|//.*$', re.M)


@dataclass
class Graph:
    """SwiftPM targets of one package graph, from `swift package dump-package`.

    Ownership and dependency walks come from affected-swift-tests.py's TargetGraph, the graph CI's
    macOS job selects with, so pre-pr's finer selection starts from the same targets.
    """
    targets: dict[str, dict]  # name -> {'type', 'path'}
    dump: dict = field(default_factory=dict)
    shared: object = None

    @classmethod
    def from_dump(cls, dump: dict) -> 'Graph':
        shared = affected_selector().TargetGraph(dump)
        targets = {name: {'type': shared.types[name], 'path': shared.paths[name].rstrip('/')}
                   for name in shared.paths}
        return cls(targets, dump, shared)

    def module_for(self, path: str) -> str | None:
        return self.shared.owner(path)

    def test_targets(self) -> list[str]:
        return [name for name in self.shared.tests if name not in UI_TEST_TARGETS]

    def covering(self, module: str) -> set[str]:
        """Test targets that are, or transitively depend on, module."""
        return self.shared.dependants({module}) & set(self.test_targets())


_GRAPHS: dict[bool, Graph | None] = {}


def load_graph(portable: bool) -> Graph | None:
    """The Apple (portable=False) or portable package graph, or None when SwiftPM can't evaluate it."""
    if portable not in _GRAPHS:
        env = {**os.environ, **({'SPEAK_PORTABLE_CORE': '1'} if portable else {})}
        env.pop('SPEAK_WINDOWS_TARGET', None)
        try:
            result = subprocess.run(['swift', 'package', 'dump-package'], cwd=ROOT, env=env, text=True,
                                    capture_output=True, timeout=300)
            _GRAPHS[portable] = Graph.from_dump(json.loads(result.stdout)) if result.returncode == 0 else None
        except (OSError, ValueError, subprocess.TimeoutExpired):
            _GRAPHS[portable] = None
    return _GRAPHS[portable]


def read(path: Path) -> str:
    try:
        return path.read_text(encoding='utf-8', errors='replace')
    except OSError:
        return ''


@dataclass
class Selection:
    filters: list[str] = field(default_factory=list)
    targets: set[str] = field(default_factory=set)  # every test target the filters touch


def select_tests(files: list[str], full: bool, graph: Graph, exclude: set[str] = frozenset(),
                 root: Path = ROOT) -> Selection:
    """Pick the unit tests a change can affect.

    A changed test file runs its own test types. A changed source file runs every test file, in any
    test target that depends on its module, that names a type the file declares or extends (or is
    named after it, e.g. Foo+Bar.swift -> Foo*Tests). When nothing names it, the module's own test
    target runs, or every covering target if it has none. --full runs whole covering targets.
    """
    whole: set[str] = set()
    classes: dict[str, set[str]] = {}
    selection = Selection()
    corpus: dict[str, list[tuple[Path, str]]] = {}

    def test_files(target: str) -> list[tuple[Path, str]]:
        if target not in corpus:
            directory = root / graph.targets[target]['path']
            corpus[target] = [(p, NOT_CODE.sub('', read(p))) for p in sorted(directory.rglob('*.swift'))]
        return corpus[target]

    def add_file(target: str, path: Path, text: str) -> bool:
        if OPT_IN.search(text):  # compiled out by default, so it has no tests to run
            return False
        names = TEST_TYPE.findall(text) or [path.stem.split('+')[0]]
        classes.setdefault(target, set()).update(re.escape(name) for name in names)
        return True

    for path in files:
        if not path.endswith('.swift') or not path.startswith(('Sources/', 'Tests/')):
            continue
        module = graph.module_for(path)
        covering = graph.covering(module) - set(exclude) if module else set()
        if not covering:
            continue
        if full:
            whole |= covering
            continue
        file = root / path
        if module in covering:  # a test file: run the types it declares
            if file.is_file():
                add_file(module, file, NOT_CODE.sub('', read(file)))
            continue
        text = read(file)
        local = {name for kind, name in DECL.findall(text) if kind != 'extension'}
        module_dir = root / graph.targets[module]['path']
        declared_in_module = None
        for kind, name in DECL.findall(text):
            if kind == 'extension' and name not in local:
                if declared_in_module is None:
                    declared_in_module = {n for p in module_dir.rglob('*.swift')
                                          for k, n in DECL.findall(read(p)) if k != 'extension'}
                if name in declared_in_module:
                    local.add(name)
        prefix = Path(path).stem.split('+')[0]
        mention = re.compile(r'\b(?:' + '|'.join(sorted(map(re.escape, local))) + r')\b') if local else None
        matched = False
        for target in sorted(covering):
            for test_path, test_text in test_files(target):
                named = fnmatch.fnmatchcase(test_path.name, f'{prefix}*Tests.swift')
                if named or (mention and mention.search(test_text)):
                    matched = add_file(target, test_path, test_text) or matched
        # No fallback when an excluded (already run) target covers the module: that run owns it.
        if not matched and not graph.covering(module) & set(exclude):
            own = f'{module}Tests'
            whole |= {own} if own in covering else covering

    for target in sorted(whole):
        selection.filters.append(f'{target}\\.')
    for target, names in sorted(classes.items()):
        if target in whole or not names:
            continue
        selection.filters.append(f'{target}\\.(?:{"|".join(sorted(names))})\\b')
    selection.targets = whole | {t for t, n in classes.items() if n}
    return selection


def uncovered_modules(files: list[str], graphs: list[Graph]) -> list[str]:
    """Changed modules that no runnable unit-test target covers, in any graph this host can build."""
    missing = set()
    for path in files:
        if Path(path).parts[1] in UI_TEST_TARGETS:
            continue
        modules = {g.module_for(path) for g in graphs} - {None}
        if modules and not any(g.covering(m) for g in graphs for m in modules if m in g.targets):
            missing |= modules
    return sorted(missing)


def test_title(selection: Selection, kind: str = 'Swift') -> str:
    targets = ', '.join(sorted(selection.targets)) or 'none'
    return f'{kind} unit tests ({targets})'


def android_runs_locally() -> bool:
    """A JDK that actually runs (macOS ships a /usr/bin/java stub) and an approved Maven feed."""
    if os.environ.get('JSTI_ANDROID_LOCAL') in ('0', '1'):
        return os.environ['JSTI_ANDROID_LOCAL'] == '1'
    try:
        jdk = subprocess.run(['java', '-version'], capture_output=True, timeout=30).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        jdk = False
    feed = bool(os.environ.get('JSTI_MAVEN_MIRROR')) or 'jsti.mavenMirror=' in read(
        Path.home() / '.gradle' / 'gradle.properties')
    return jdk and feed


def merge_base_or(base: str) -> str:
    """The merge base with base, or base itself when history can't tell (a shallow CI checkout)."""
    return git('merge-base', 'HEAD', base, check=False) or base


def pr_title_env() -> dict[str, str]:
    """The open PR's title, whose '!' marker declares an intended API break; else commit subjects decide."""
    if os.environ.get('PR_TITLE'):
        return {'PR_TITLE': os.environ['PR_TITLE']}
    try:
        result = subprocess.run(['gh', 'pr', 'view', '--json', 'title', '--jq', '.title'], cwd=ROOT, text=True,
                                capture_output=True, timeout=30)
    except (OSError, subprocess.TimeoutExpired):
        return {}
    return {'PR_TITLE': result.stdout.strip()} if result.returncode == 0 and result.stdout.strip() else {}


@functools.cache
def routing():
    """scripts/ci/routing.py: the path routes CI's workflow filters are generated from."""
    spec = importlib.util.spec_from_file_location('ci_routing', Path(__file__).resolve().parent / 'ci' / 'routing.py')
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


@functools.cache
def affected_selector():
    spec = importlib.util.spec_from_file_location('affected_swift_tests',
                                                  Path(__file__).resolve().parent / 'ci' / 'affected-swift-tests.py')
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def ci_macos_tests(files: list[str], graph: Graph) -> Selection:
    """The macOS job's pull-request selection: scripts/ci/affected-swift-tests.py over the same changed files."""
    _, selected = affected_selector().select(files, graph.dump, CI_MACOS_SKIP_TARGETS)
    selected = [t for t in selected if t not in UI_TEST_TARGETS]
    return Selection([f'^({"|".join(map(re.escape, selected))})\\.'], set(selected)) if selected else Selection()


def plan(files: list[str], full: bool, quick: bool = False, linux: str = 'auto', base: str = 'origin/main'
         ) -> tuple[list[Check], dict[str, list[str]]]:
    """Mirror the CI Gate's pull-request jobs (Lint, Portable Swift (Linux), the macOS job) for these files.

    full: whole affected test targets. quick: type-level test selection instead of CI's target-level one.
    linux: auto (container if available, else remote), container, remote, or skip (result 'incomplete').
    """
    areas: dict[str, list[str]] = {}

    def area(name: str, route: str) -> list[str]:
        hits = [f for f in files if routing().matches(route, f, pre_pr=True)]
        if hits:
            areas[name] = hits
        return hits

    # scripts/ci/routing.json owns these routes; ci.yml's and android.yml's path filters are generated from it.
    apple = area('ci-lint', 'apple')
    swift = area('swift', 'swift')
    api = area('public-api', 'api')
    windows = area('windows', 'windows')
    workflows = area('workflows', 'workflows')
    shell = area('shell', 'shell')
    android = area('android', 'android')
    worker = area('paid-access-worker', 'paid-access-worker')
    landing = area('landing-page', 'landing-page')

    checks: list[Check] = []
    existing = [f for f in files if (ROOT / f).is_file()]
    swift_files = [f for f in existing if f.endswith('.swift') and not f.startswith(('Tooling/', 'android/'))]
    swift_changes = [f for f in files if f.endswith('.swift') and f.startswith(('Sources/', 'Tests/'))]
    test_env = {'JSTI_TEST_KEYCHAIN_REDIRECT': '1', 'JSTI_TEST_KEYCHAIN': '1'}
    scratch = ['--scratch-path', str(OUT / 'apple-build')]

    if swift:
        # Portable Swift (Linux): the CI job's own script in the CI image, started first because it is slowest.
        title = 'Portable Swift (Linux): scripts/ci-portable-linux.sh in swift:6.2.3-jammy'
        if linux == 'skip':
            checks.append(Check('portable-linux', 'swift', title, [], skip_reason='--no-linux', incomplete=True))
        else:
            mode = [] if linux == 'auto' else [f'--{linux}']
            checks.append(Check('portable-linux', 'swift', title,
                                ['python3', 'scripts/linux-precheck', *mode, '--tree', str(ROOT), '--base', base], background=True))
    if apple:
        # Lint: exactly the ci.yml Lint job (whole-repo strict SwiftLint, accessibility, tooling pins and tests).
        checks.append(Check('ci-lint', 'ci-lint', 'CI Lint job (make ci-lint)', ['make', 'ci-lint'],
                            env={'JSTI_LINT_BASELINE_BASE': base}, forbid_drift=('Tooling/Package.resolved',)))
        if not sys.platform.startswith('linux') and linux != 'skip':
            # CI runs Lint on Ubuntu, where Apple-only tooling tests skip and others behave differently.
            checks.append(Check('ci-lint-linux', 'ci-lint', 'CI Lint job on Ubuntu (make ci-lint), remote',
                                ['python3', 'scripts/linux-precheck', '--job', 'lint', '--tree', str(ROOT),
                                 '--base', base], background=True))
        elif linux == 'skip' and not sys.platform.startswith('linux'):
            checks.append(Check('ci-lint-linux', 'ci-lint', 'CI Lint job on Ubuntu (make ci-lint)', [],
                                skip_reason='--no-linux', incomplete=True))
    if swift_files:
        checks.append(Check('swiftformat', 'ci-lint', 'SwiftFormat lint (changed files, advisory)',
                            ['scripts/swiftformat.sh', '--lint', '--quiet', *swift_files], advisory=True))
    if swift and not IS_MAC:
        checks.append(Check('apple-build', 'swift', 'macOS job: SwiftPM build and unit tests', [],
                            skip_reason='macOS only; CI runs it'))
    elif swift:
        checks.append(Check('apple-build', 'swift', 'macOS job: SwiftPM build incl. tests',
                            ['swift', 'build', '--build-tests', *scratch], env=test_env, requires='swift',
                            forbid_drift=('Package.resolved',)))
        skipped = sorted({Path(f).parts[1] for f in swift_changes if Path(f).parts[1] in UI_TEST_TARGETS})
        if skipped:
            print(f'pre-pr: never runs UI test targets: {", ".join(skipped)} (CI covers them)')
        graph = load_graph(False)
        if graph is None:
            checks.append(Check('apple-unit-tests', 'swift', 'macOS job: unit tests', [],
                                failure='swift package dump-package failed, so no tests could be selected'))
        else:
            if full:
                every = [t for t in graph.test_targets() if t not in CI_MACOS_SKIP_TARGETS]
                selection = Selection([f'^({"|".join(every)})\\.'], set(every))
            elif quick:
                selection = select_tests(swift_changes, False, graph, exclude=CI_MACOS_SKIP_TARGETS)
            else:
                selection = ci_macos_tests(files, graph)
            if selection.filters:
                checks.append(Check('apple-unit-tests', 'swift', test_title(selection, 'macOS job:'),
                                    ['python3', 'scripts/with-test-keychain.py', 'swift', 'test', '--skip-build',
                                     *scratch, '--filter', '|'.join(selection.filters)],
                                    env=test_env, requires='swift', counts_tests=True))
            graphs = [g for g in (graph, load_graph(True) if swift_changes else None) if g]
            missing = uncovered_modules(swift_changes, graphs)
            if missing:
                checks.append(Check('swift-test-coverage', 'swift', 'Every changed Swift module has unit tests', [],
                                    failure=f'no unit-test target covers {", ".join(missing)}; add tests for it'))
    if windows:
        checks.append(Check('windows-typecheck', 'windows', 'Windows Swift type check',
                            ['bash', 'scripts/typecheck-windows-swift.sh'],
                            env={'SPEAK_WINDOWS_TYPECHECK_DIR': str(OUT / 'windows-typecheck')},
                            # The executable target links Win32 libraries under Xcode's toolchain;
                            # CI runs this check on Linux (linux.yml); Portable Swift (Linux) covers the shared graph.
                            skip_reason='' if sys.platform.startswith('linux') else 'Linux only; CI runs it'))
    if api:
        # The Public API compatibility job's own script, against the merge base (CI's PR baseline).
        title = 'Public API compatibility (scripts/ci-api-compatibility.sh)'
        if IS_MAC:
            checks.append(Check('api-compatibility', 'public-api', title,
                                ['bash', 'scripts/ci-api-compatibility.sh', merge_base_or(base)],
                                env=pr_title_env(), requires='swift', forbid_drift=('Package.resolved',)))
        else:
            checks.append(Check('api-compatibility', 'public-api', title, [], skip_reason='macOS only',
                                incomplete=True))
    changed_workflows = [f for f in workflows if f.startswith('.github/workflows/') and (ROOT / f).is_file()]
    if changed_workflows:
        # Advisory: CI does not gate on actionlint and local versions can lag new workflow syntax.
        checks.append(Check('actionlint', 'workflows', 'actionlint (changed workflows, advisory)',
                            ['actionlint', *changed_workflows], requires='actionlint', advisory=True))
    shell_files = [f for f in shell if (ROOT / f).is_file() and not f.endswith(('pre-pr', '.py'))]
    if shell_files:
        checks.append(Check('shellcheck', 'shell', 'ShellCheck (changed scripts, advisory)',
                            ['shellcheck', '-S', 'warning', *shell_files],
                            requires='shellcheck', advisory=True))
    if android:
        # The Android CI job's script. Locally only with a working JDK and an approved feed
        # (android/settings.gradle.kts refuses public registries off GitHub-hosted runners);
        # otherwise on a remote precheck/** branch. Never a skip.
        title = 'Android CI job (scripts/ci-android.sh)'
        if android_runs_locally():
            checks.append(Check('android', 'android', title, ['bash', 'scripts/ci-android.sh']))
        else:
            checks.append(Check('android', 'android', f'{title}, remote',
                                ['python3', 'scripts/linux-precheck', '--job', 'android', '--tree', str(ROOT),
                                 '--base', base], background=True))
    if worker:
        directory = ROOT / 'workers' / 'paid-access'
        checks.append(Check('worker-install', 'paid-access-worker', 'npm ci',
                            ['npm', 'ci', '--no-audit', '--no-fund'], cwd=directory, requires='npm'))
        for script in ('typecheck', 'lint', 'test'):
            checks.append(Check(f'worker-{script}', 'paid-access-worker', f'npm run {script}',
                                ['npm', 'run', script], cwd=directory, requires='npm'))
    if landing:
        checks.append(Check('landing-tests', 'landing-page', 'Landing page tests', ['npm', 'test'],
                            cwd=ROOT / 'landing-page', requires='npm'))
    checks.sort(key=lambda check: (not check.background, COST.get(check.id, 3)))
    return checks, areas


def dirty_tracked() -> set[str]:
    return set(filter(None, git('diff', '--name-only', 'HEAD').splitlines()))


def restore_side_effects(check: Check, dirty_before: set[str]) -> None:
    """Undo tracked-file changes a check made (the portable graph deletes Package.resolved)."""
    touched = sorted(dirty_tracked() - dirty_before)
    if touched:
        git('checkout', 'HEAD', '--', *touched)
        restored = f'restored {", ".join(touched[:3])}{"…" if len(touched) > 3 else ""}'
        check.note = f'{check.note}; {restored}' if check.note else restored


def display(path: Path) -> str:
    try:
        return str(path.relative_to(ROOT))
    except ValueError:
        return str(path)


def tests_executed(log: str) -> int:
    """Tests run according to XCTest ("Executed N tests") and Swift Testing ("Test run with N tests")."""
    xctest = [int(n) for n in re.findall(r'Executed (\d+) tests?', log)]
    testing = [int(n) for n in re.findall(r'Test run with (\d+) tests?', log)]
    return max(xctest, default=0) + max(testing, default=0)


def launch(check: Check) -> subprocess.Popen | None:
    """Start a check with its output going to its log, or settle it at once (skip, planning failure, no tool)."""
    if check.skip_reason:
        check.status, check.note = 'skip', check.skip_reason
        return None
    if check.failure:
        check.status, check.note = 'fail', check.failure
        return None
    if check.requires and not shutil.which(check.requires):
        # Fail closed: a required check that cannot run is not a pass.
        check.status = 'warn' if check.advisory else 'fail'
        check.note = f'{check.requires} not installed'
        return None
    check.log.parent.mkdir(parents=True, exist_ok=True)
    env = {**os.environ, 'PYTHONDONTWRITEBYTECODE': '1', **check.env}
    check.dirty_before = dirty_tracked() if not check.background else set()
    check.started = time.monotonic()
    log = check.log.open('w', encoding='utf-8')
    log.write(f'$ {" ".join(check.command)}\n')
    log.flush()
    try:
        return subprocess.Popen(check.command, cwd=check.cwd, env=env, stdout=log, stderr=subprocess.STDOUT,
                                text=True, stdin=subprocess.DEVNULL)
    except OSError as error:
        log.write(f'{error}\n')
        check.status, check.note = ('warn' if check.advisory else 'fail'), f'cannot start: {error.strerror}'
        return None
    finally:
        log.close()


def finish(check: Check, process: subprocess.Popen | None, verbose: bool) -> None:
    if process is None:
        return
    code = process.wait()
    check.duration = time.monotonic() - check.started
    text = check.log.read_text(encoding='utf-8', errors='replace')
    if verbose:
        sys.stdout.write(''.join(f'    {line}\n' for line in text.splitlines()))
    executed = tests_executed(text) if check.counts_tests else None
    if code != 0:
        check.status = 'warn' if check.advisory else 'fail'
        check.note = f'exit {code}; log {display(check.log)}'
    elif executed == 0:
        check.status, check.note = 'fail', f'no tests matched the filter; log {display(check.log)}'
    else:
        check.status = 'pass'
        if executed:
            check.note = f'{executed} tests'
    if check.background:
        return
    drifted = sorted(set(check.forbid_drift) & (dirty_tracked() - check.dirty_before))
    if drifted and check.status == 'pass':
        check.status = 'fail'
        check.note = f'modified {", ".join(drifted)} (CI fails on this drift); commit the regenerated file'
    restore_side_effects(check, check.dirty_before)


def run(check: Check, verbose: bool) -> None:
    finish(check, launch(check), verbose)


def worktree_tree() -> str:
    """The git tree of the working tree as checked: tracked, modified and untracked (not ignored) files."""
    with tempfile.TemporaryDirectory() as scratch:
        env = {**os.environ, 'GIT_INDEX_FILE': str(Path(scratch) / 'index')}
        for command in (['read-tree', 'HEAD'], ['add', '-A', '--', '.'], ['write-tree']):
            result = subprocess.run(['git', *command], cwd=ROOT, env=env, text=True, capture_output=True)
            if result.returncode != 0:
                return ''
    return result.stdout.strip()


def markdown(summary: dict) -> str:
    icon = {'pass': '✅', 'fail': '❌', 'warn': '⚠️', 'skip': '⏭️', 'pending': '…'}
    lines = [f'### Pre-PR checks: {summary["result"].upper()}',
             f'`scripts/pre-pr` at `{summary["head"][:12]}`{" (dirty tree)" if summary["dirty"] else ""} '
             f'against `{summary["base_ref"]}` ({summary["merge_base"][:12]}), '
             f'{summary["changed_file_count"]} changed files, {summary["duration_seconds"]:.0f}s.',
             '', '| Check | Area | Result | Time |', '|---|---|---|---|']
    for check in summary['checks']:
        note = f' ({check["note"]})' if check['note'] else ''
        lines.append(f'| {check["title"]} | {check["area"]} | {icon[check["status"]]} {check["status"]}{note} '
                     f'| {check["duration_seconds"]:.0f}s |')
    if not summary['checks']:
        lines.append('| (no checks apply to these paths) | | ✅ pass | 0s |')
    lines.append('')
    keys = ('schema', 'head', 'tree', 'result')
    lines.append('<!-- pre-pr-summary ' + json.dumps({k: summary[k] for k in keys if k in summary}) + ' -->')
    return '\n'.join(lines)


# One pre-pr at a time per user on this machine, across every worktree: several
# agents running the macOS build, Lint tooling tests and Swift tests at once
# drove load past 300 and turned timing-sensitive tests into false failures.
# JSTI_PRE_PR_LOCK=off disables it; any other value is the lock file path.
LOCK_PATH = Path.home() / '.cache' / 'jsti-pre-pr.lock'


@contextlib.contextmanager
def machine_lock(setting: str | None = None):
    setting = os.environ.get('JSTI_PRE_PR_LOCK', '') if setting is None else setting
    try:
        import fcntl
    except ImportError:  # Windows: no flock; run unlocked.
        fcntl = None
    if setting == 'off' or fcntl is None:
        yield
        return
    path = Path(setting) if setting else LOCK_PATH
    path.parent.mkdir(parents=True, exist_ok=True)
    with open(path, 'a+', encoding='utf-8') as handle:
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            handle.seek(0)
            holder = handle.read().strip() or 'another worktree'
            print(f'pre-pr: waiting for the machine-wide lock held by {holder} '
                  f'(set JSTI_PRE_PR_LOCK=off to skip)', flush=True)
            waited = time.monotonic()
            fcntl.flock(handle, fcntl.LOCK_EX)
            print(f'pre-pr: lock acquired after {time.monotonic() - waited:.0f}s', flush=True)
        handle.seek(0)
        handle.truncate()
        handle.write(f'pid {os.getpid()} in {Path.cwd()}\n')
        handle.flush()
        try:
            yield
        finally:
            handle.seek(0)
            handle.truncate()
            fcntl.flock(handle, fcntl.LOCK_UN)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.split('\n\n')[0])
    parser.add_argument('--base', default='origin/main')
    parser.add_argument('--fetch', action='store_true', help='fetch the base before comparing')
    parser.add_argument('--full', action='store_true', help='run every macOS unit-test target CI could run')
    parser.add_argument('--quick', action='store_true',
                        help='type-level macOS test selection (faster, but narrower than CI)')
    linux = parser.add_mutually_exclusive_group()
    linux.add_argument('--remote-linux', dest='linux', action='store_const', const='remote',
                       help='run Portable Swift (Linux) on a precheck/** branch even if a container runtime exists')
    linux.add_argument('--container-linux', dest='linux', action='store_const', const='container',
                       help='run Portable Swift (Linux) with local docker or podman')
    linux.add_argument('--no-linux', dest='linux', action='store_const', const='skip',
                       help="skip Portable Swift (Linux); the result is then 'incomplete', which CI rejects")
    parser.add_argument('--plan', action='store_true', help='print the selected checks and exit')
    parser.add_argument('--keep-going', action='store_true', help='run every check even after a failure')
    parser.add_argument('--markdown', action='store_true', help='print the PR-body summary when done')
    parser.add_argument('--verbose', '-v', action='store_true', help='stream check output')
    args = parser.parse_args()

    if args.fetch and args.base.startswith('origin/'):
        git('fetch', '--quiet', 'origin', args.base.removeprefix('origin/'))
    merge_base, files = changed_files(args.base)
    checks, areas = plan(files, args.full, args.quick, args.linux or 'auto', args.base)
    head = git('rev-parse', 'HEAD')
    tree = worktree_tree()
    dirty = bool(git('status', '--porcelain'))

    print(f'pre-pr: {len(files)} changed files against {args.base} ({merge_base[:12]})')
    for name, hits in areas.items():
        print(f'  {name:<20} {len(hits)} file{"s" if len(hits) != 1 else ""}')
    if args.plan:
        for check in checks:
            print(f'  would run [{check.area}] {check.title}: {" ".join(check.command)[:160]}')
        return 0

    with machine_lock():
        return execute(args, checks, areas, files, merge_base, head, tree, dirty)


def execute(args, checks, areas, files, merge_base, head, tree, dirty) -> int:
    started = time.monotonic()
    failed = False

    def report(check: Check) -> None:
        nonlocal failed
        mark = {'pass': '✅', 'fail': '❌', 'warn': '⚠️', 'skip': '⏭️', 'pending': '…'}[check.status]
        print(f'  {mark} [{check.area}] {check.title}: {check.status} in {check.duration:.0f}s'
              f'{" — " + check.note if check.note else ""}', flush=True)
        if check.status == 'fail':
            failed = True
            if check.log.exists():
                tail = check.log.read_text(encoding='utf-8', errors='replace').splitlines()[-40:]
                print('\n'.join(f'    │ {line}' for line in tail))

    background = []
    for check in checks:
        if check.background:
            print(f'▶ [{check.area}] {check.title} (in the background; log {display(check.log)})', flush=True)
            background.append((check, launch(check)))
    for check in checks:
        if check.background:
            continue
        if failed and not args.keep_going and not check.advisory:
            check.status, check.note = 'skip', 'earlier failure'
            print(f'⏭️  [{check.area}] {check.title} — skipped after an earlier failure')
            continue
        print(f'▶ [{check.area}] {check.title}', flush=True)
        run(check, args.verbose)
        report(check)
    for check, process in background:
        if process is not None and failed and not args.keep_going:
            process.terminate()  # linux-precheck deletes its branch on SIGTERM
            process.wait()
            check.status, check.note = 'skip', 'stopped after an earlier failure'
        else:
            if process is not None:
                print(f'… waiting for [{check.area}] {check.title}', flush=True)
            finish(check, process, args.verbose)
        report(check)
    incomplete = any(c.incomplete for c in checks)

    summary = {
        'schema': SCHEMA_VERSION,
        'tool': 'scripts/pre-pr',
        'generated_at': dt.datetime.now(dt.timezone.utc).isoformat(timespec='seconds'),
        'head': head, 'tree': tree, 'dirty': dirty, 'base_ref': args.base, 'merge_base': merge_base,
        'full': args.full, 'changed_file_count': len(files), 'areas': sorted(areas),
        'result': 'fail' if failed else 'incomplete' if incomplete else 'pass',
        'duration_seconds': round(time.monotonic() - started, 1),
        'checks': [{'id': c.id, 'area': c.area, 'title': c.title, 'status': c.status,
                    'advisory': c.advisory, 'duration_seconds': round(c.duration, 1), 'note': c.note,
                    'command': c.command[:8]} for c in checks],
    }
    OUT.mkdir(parents=True, exist_ok=True)
    (OUT / 'summary.json').write_text(json.dumps(summary, indent=2) + '\n', encoding='utf-8')
    (OUT / 'summary.md').write_text(markdown(summary) + '\n', encoding='utf-8')
    print(f'pre-pr: {summary["result"].upper()} in {summary["duration_seconds"]:.0f}s — '
          f'summary in {display(OUT / "summary.json")} and summary.md')
    if args.markdown:
        print(markdown(summary))
    return 1 if failed or incomplete else 0


if __name__ == '__main__':
    sys.exit(main())
