<!-- Android 11 and older: back up only the iCloud sign-in token file, and only encrypted or device to device. -->
<full-backup-content>
    <include domain="file" path="restore/cloudkit-web-auth-token" requireFlags="clientSideEncryption|deviceToDeviceTransfer" />
</full-backup-content>
