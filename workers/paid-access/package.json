{
  "name": "@justspeaktoit/paid-access-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Paid Access backend for Just Speak to It — entitlements, billing and provider proxying on Cloudflare Workers.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrations:local": "wrangler d1 migrations apply paid-access --local",
    "migrations:remote": "wrangler d1 migrations apply paid-access --remote"
  },
  "dependencies": {
    "jose": "^6.2.15"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "~1.6.0",
    "@cloudflare/workers-types": "^5.20261104.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "~5.1.0",
    "wrangler": "^4.158.0"
  },
  "overrides": {
    "minimatch@>=7 <11.0.1": "^11.0.4",
    "sharp": "0.35.5",
    "undici": "7.30.1",
    "zod": "4.6.6"
  }
}
